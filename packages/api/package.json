{
  "name": "@rivaleye/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash start-dev.sh",
    "start": "bun --env-file=../../.env src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio",
    "seed": "bun src/scripts/seed.ts"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "@openrouter/sdk": "^0.12.35",
    "@rivaleye/scrapers": "workspace:*",
    "@rivaleye/shared": "workspace:*",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.4.28",
    "elysia-helmet": "^3.1.0",
    "inngest": "^3.27.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "puppeteer": "^25.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
