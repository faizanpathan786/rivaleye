{
  "name": "@rivaleye/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:scrape": "bun --watch src/scrape/index.ts",
    "dev:llm":    "bun --watch src/llm/index.ts",
    "dev:synth":  "bun --watch src/synth/index.ts",
    "dev":        "concurrently -n scrape,llm,synth -c blue,green,yellow \"pnpm dev:scrape\" \"pnpm dev:llm\" \"pnpm dev:synth\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:bun": "bun test --env-file=../../.env src/__tests__/",
    "test:e2e": "bun test --env-file=../../.env src/__tests__/e2e-pipeline.test.ts --timeout 60000"
  },
  "dependencies": {
    "@rivaleye/scrapers": "workspace:*",
    "@rivaleye/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "inngest": "^3.27.0",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
