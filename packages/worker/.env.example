# Database
CONNECTION_STRING=postgresql://user:password@localhost:5432/rivaleye

# Pipeline engine (postgres or inngest)
REPORT_PIPELINE_ENGINE=postgres

# LLM APIs
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-chat
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Inngest (only required when REPORT_PIPELINE_ENGINE=inngest)
INNGEST_EVENT_KEY=your-inngest-key

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=RivalEye/1.0

# Third-party platforms (Apify, etc.)
APIFY_TOKEN=your-apify-token
GOOGLE_PLACES_API_KEY=your-google-places-key

# Product Hunt
PRODUCTHUNT_TOKEN=your-producthunt-token

# Twitter/X API
X_API_BEARER=your-x-api-bearer

# Trustpilot
TRUSTPILOT_API_KEY=your-trustpilot-key

# Worker ports
WORKER_SCRAPE_PORT=4001
WORKER_LLM_PORT=4002
WORKER_SYNTH_PORT=4003
