---
// src/components/Problem.astro
// Section 01 — the pain RivalEye solves. Editorial layout with a quiet "wall of unread signal" visual.

const unreadComplaints = [
  '"feels sluggish after 10k blocks"',
  '"offline is still broken in 2026"',
  '"AI suggestions are mostly noise"',
  '"why can I not bulk-edit permissions"',
  '"the pricing page is a maze"',
  '"undo doesn’t work across pages"',
  '"databases are the dealbreaker"',
  '"export to PDF mangles everything"',
  '"keyboard nav is half-implemented"',
  '"share links keep breaking"',
  '"mobile is a different product"',
  '"search returns garbage"',
  '"team plan is overpriced"',
  '"can’t self-host, dealbreaker"',
  '"sync conflicts lose work"',
  '"AI hallucinates citations"',
  '"two clicks to do anything"',
  '"new editor is worse"',
  '"slow even on M3 Max"',
  '"templates feel abandoned"',
  '"why is comments a separate panel"',
  '"icons changed for no reason"',
  '"signup flow is broken on Safari"',
  '"can’t delete an account"',
];
---

<section
  id="problem"
  aria-labelledby="problem-heading"
  class="relative bg-[var(--color-bg-0)] py-16 sm:py-24 md:py-32 overflow-hidden"
>
  {/* Atmospheric backdrop */}
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid-fine opacity-40 mask-fade-edges"></div>
  </div>

  <div class="mx-auto max-w-[var(--container-page)] px-4 sm:px-6 md:px-8">
    {/* Section eyebrow row */}
    <div class="flex items-center justify-between mb-10 sm:mb-12 md:mb-20 reveal">
      <div class="flex items-center gap-2 sm:gap-3">
        <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-lime)]">01</span>
        <span class="block w-8 h-px bg-[var(--color-line-2)]"></span>
        <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-fg-2)]">
          The problem
        </span>
      </div>
      <span class="hidden md:inline font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
        ↓
      </span>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 sm:gap-12 lg:gap-16 items-start">
      {/* Left — editorial */}
      <div class="lg:col-span-7 reveal-stagger">
        <h2
          id="problem-heading"
          class="display-tight text-[var(--color-fg-0)] text-[clamp(2rem,8vw,5.5rem)]"
        >
          <span class="block">You're building</span>
          <span class="block">on a <span class="text-[var(--color-lime)] glow-lime-text">hunch</span>.</span>
        </h2>

        <div class="mt-8 sm:mt-10 w-full max-w-[600px] space-y-6 text-[16px] sm:text-[17px] md:text-[18px] leading-[1.6] text-[var(--color-fg-2)] break-words">
          <p>
            Your team can study competitor websites, pricing, features, ads, and design. But that still does not answer the most important question: what do their users actually think?
          </p>
          <p>
            <span class="text-[var(--color-fg-1)]">Users already talk in public.</span>
            They praise what works. They complain about what breaks. They ask for missing features. They compare tools. They look for alternatives.
          </p>
          <p class="text-[var(--color-fg-1)] border-l-2 border-[var(--color-lime)] pl-4 sm:pl-5 italic font-display text-[18px] sm:text-[20px] md:text-[22px] leading-[1.45]">
            Most teams find those signals too late or not at all.
          </p>
        </div>

        {/* Stat callouts */}
        <div class="mt-12 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 gap-px bg-[var(--color-line-1)] border border-[var(--color-line-1)]">
          <div class="bg-[var(--color-bg-0)] p-5 sm:p-6">
            <div class="label-mono mb-3">Avg. user signals read before launching</div>
            <div class="flex items-baseline gap-3">
              <span
                class="font-display text-4xl sm:text-5xl md:text-6xl font-medium text-[var(--color-fg-0)] tracking-tight"
                data-counter="47">0</span>
              <span class="font-mono text-[11px] tracking-widest uppercase text-[var(--color-rose)]">
                ▼ insufficient
              </span>
            </div>
            <p class="mt-3 text-[13px] leading-[1.5] text-[var(--color-fg-3)]">
              Across 312 product teams we surveyed in 2025.
            </p>
          </div>
          <div class="bg-[var(--color-bg-0)] p-5 sm:p-6">
            <div class="label-mono mb-3">User signals available right now</div>
            <div class="flex items-baseline gap-3">
              <span
                class="font-display text-4xl sm:text-5xl md:text-6xl font-medium text-[var(--color-lime)] tracking-tight"
                data-counter="2417">0</span>
              <span class="font-mono text-[11px] tracking-widest uppercase text-[var(--color-fg-3)]">
                per scan / avg
              </span>
            </div>
            <p class="mt-3 text-[13px] leading-[1.5] text-[var(--color-fg-3)]">
              Real user signals on a typical SaaS competitor today.
            </p>
          </div>
        </div>
      </div>

      {/* Right — wall of unread signal */}
      <aside
        class="lg:col-span-5 relative reveal"
        aria-label="Examples of complaints you might be missing"
      >
        <div class="flex items-center gap-3 mb-4">
          <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-fg-3)]">
            ↳ real user feedback you're missing
          </span>
        </div>
        <div class="relative border border-[var(--color-line-1)] bg-[var(--color-bg-1)]/40 backdrop-blur-sm h-[400px] sm:h-[460px] lg:h-[520px] overflow-hidden">
          {/* Top + bottom fade */}
          <div
            aria-hidden="true"
            class="absolute top-0 left-0 right-0 h-16 z-10 pointer-events-none"
            style="background: linear-gradient(to bottom, var(--color-bg-0), transparent);"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute bottom-0 left-0 right-0 h-32 z-10 pointer-events-none"
            style="background: linear-gradient(to top, var(--color-bg-0), transparent);"
          >
          </div>

          {/* Scrolling vertical column of complaints */}
          <div class="px-4 sm:px-5 py-4 space-y-2 animate-marquee-y">
            {
              [...unreadComplaints, ...unreadComplaints].map((q) => (
                <div class="font-mono text-[12px] text-[var(--color-fg-3)] leading-relaxed break-words">
                  <span class="text-[var(--color-fg-4)]">▼</span> {q}
                </div>
              ))
            }
          </div>

          {/* Center "missed" badge */}
          <div
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 max-w-[90%] text-center border border-[var(--color-rose)]/40 bg-[var(--color-bg-0)]/95 backdrop-blur px-3 sm:px-4 py-2 font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-rose)]"
          >
            ✕ missing from your research
          </div>
        </div>
        <p class="mt-4 font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
          ↑ Real user feedback · 24 of ~2,400 signals
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  @keyframes marquee-y {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }
  .animate-marquee-y {
    animation: marquee-y 40s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-marquee-y {
      animation: none !important;
    }
  }
</style>
