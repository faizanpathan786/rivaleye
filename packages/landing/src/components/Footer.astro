---
// src/components/Footer.astro
const columns = [
  {
    label: 'Product',
    links: [
      { label: 'How it works', href: '#how' },
      { label: 'Report lenses', href: '#lenses' },
      { label: 'Sample report', href: '#report' },
      { label: 'Pricing', href: '#cta' },
    ],
  },
  {
    label: 'Company',
    links: [
      { label: 'About', href: '#about' },
      { label: 'Changelog', href: '#changelog' },
      { label: 'Manifesto', href: '#manifesto' },
      { label: 'Contact', href: 'mailto:hi@rivaleye.io' },
    ],
  },
  {
    label: 'Legal',
    links: [
      { label: 'Privacy', href: '#privacy' },
      { label: 'Terms', href: '#terms' },
      { label: 'Data sources', href: '#sources' },
      { label: 'Security', href: '#security' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="relative bg-[var(--color-bg-1)] border-t border-[var(--color-line-2)] overflow-hidden">
  {/* Faint backdrop */}
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-grid-fine opacity-20 mask-fade-edges"></div>

  <div class="mx-auto max-w-[var(--container-page)] px-4 sm:px-5 md:px-8 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      {/* Wordmark + tagline */}
      <div class="lg:col-span-5">
        <a href="/" class="group inline-flex items-center gap-2.5 mb-6" aria-label="RivalEye home">
          <img src="/logo.svg" alt="RivalEye logo" width="32" height="32" style="object-fit:contain;border-radius:6px;" />
          <span class="flex items-baseline gap-2">
            <span class="font-display text-[19px] font-medium tracking-tight text-[var(--color-fg-0)]">
              Rival<span class="text-[var(--color-lime)]">Eye</span>
            </span>
            <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
              / intel
            </span>
          </span>
        </a>
        <p class="max-w-[36ch] text-[15px] leading-[1.55] text-[var(--color-fg-2)] mb-8">
          See what users really think about your competitors.
        </p>

        {/* Live status indicator */}
        <div
          class="inline-flex items-center gap-2.5 border border-[var(--color-line-2)] bg-[var(--color-bg-0)] px-3.5 py-2"
        >
          <span
            class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime"
          ></span>
          <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-fg-2)]">
            All systems · operational
          </span>
        </div>
      </div>

      {/* Link columns */}
      <nav class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-8 sm:gap-8" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h3 class="label-mono mb-4 sm:mb-5">{col.label}</h3>
              <ul class="space-y-1 sm:space-y-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex items-center gap-2 py-2 sm:py-0 min-h-[40px] sm:min-h-0 text-[14px] text-[var(--color-fg-1)] hover:text-[var(--color-lime)] transition-colors"
                    >
                      <span class="text-[var(--color-fg-4)] group-hover:text-[var(--color-lime)] transition-colors text-[10px]">
                        ↳
                      </span>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
  </div>

  {/* Bottom status row */}
  <div class="border-t border-[var(--color-line-1)] bg-[var(--color-bg-0)]/60">
    <div
      class="mx-auto max-w-[var(--container-page)] px-4 sm:px-5 md:px-8 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 md:gap-4 font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
        <span>© {year} RivalEye</span>
        <span class="text-[var(--color-fg-4)]">·</span>
        <span>SIG_v0.2.4-beta</span>
        <span class="text-[var(--color-fg-4)]">·</span>
        <span>session.atl-03</span>
      </div>
      <div class="flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-[0.18em] uppercase">
        <span class="text-[var(--color-fg-3)]">scan.engine</span>
        <span class="text-[var(--color-fg-4)]">·</span>
        <span class="text-[var(--color-lime)]">v4.7</span>
      </div>
    </div>
  </div>
</footer>
