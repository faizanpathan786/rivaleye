---
// src/components/SampleReport.astro
// Section 04 — the deliverable. Animated mock of the actual Pain Report.

// Featured cluster quotes — sourced
const evidence = [
  {
    quote: 'feels sluggish after 10k blocks. m1 max chokes.',
    src: 'r/Notion',
    upvotes: 412,
    date: '14d ago',
  },
  {
    quote: 'pages take 8s to load on a fresh laptop. unusable for big teams.',
    src: 'Reddit',
    upvotes: 287,
    date: '6d ago',
  },
  {
    quote: 'database with 5k rows = death. our wiki is held together by prayer.',
    src: 'Product Hunt',
    upvotes: 156,
    date: '3w ago',
  },
  {
    quote: 'switched to obsidian. notion is just too slow at our scale.',
    src: 'App Store',
    upvotes: 341,
    date: '2d ago',
  },
];

// Small clusters for the heatmap grid (severity 0–100)
const heatmap = [
  92, 88, 84, 78, 76, 71, 68, 64, 61, 58,
  55, 52, 49, 47, 44, 42, 40, 38, 36, 35,
  33, 31, 29, 28, 26, 25, 24, 22, 21, 20,
  19, 18, 17, 16, 15, 14, 13, 13, 12, 12,
  11, 10, 10, 9, 9, 8, 8, 7, 7, 6,
];

// Quick map severity → opacity for visual encoding
const opacityFor = (s: number) => {
  if (s >= 75) return 1;
  if (s >= 50) return 0.75;
  if (s >= 30) return 0.5;
  if (s >= 15) return 0.3;
  return 0.15;
};

const sideStats = [
  { label: 'Complaints analyzed', value: '2,417' },
  { label: 'Clusters detected', value: '83' },
  { label: 'Sources crossed', value: '8 / 8' },
  { label: 'Scan duration', value: '4m 12s' },
];
---

<section
  id="report"
  aria-labelledby="report-heading"
  class="relative bg-[var(--color-bg-0)] py-24 md:py-32 border-t border-[var(--color-line-1)] overflow-hidden"
>
  {/* Backdrop */}
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid opacity-40 mask-fade-edges"></div>
    <div
      class="absolute top-1/3 -left-40 w-[600px] h-[600px] rounded-full opacity-[0.05] blur-[140px]"
      style="background: radial-gradient(circle, var(--color-lime) 0%, transparent 70%);"
    >
    </div>
  </div>

  <div class="mx-auto max-w-[var(--container-page)] px-5 md:px-8">
    {/* Header */}
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-12 md:mb-16 reveal-stagger"
    >
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-lime)]"
            >04</span
          >
          <span class="block w-8 h-px bg-[var(--color-line-2)]"></span>
          <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-fg-2)]">
            The deliverable
          </span>
        </div>
        <h2
          id="report-heading"
          class="display-tight text-[var(--color-fg-0)] text-[clamp(2rem,5.5vw,5rem)] max-w-[18ch]"
        >
          A competitor report your team can actually use.
        </h2>
      </div>
      <p class="max-w-[420px] text-[15px] md:text-[16px] leading-[1.6] text-[var(--color-fg-2)]">
        Every report shows what users love and hate, what they ask for, who's ready to switch with evidence, sources, and a clear opportunity to attack.
      </p>
    </div>

    {/* === The report mock ============================================== */}
    <div class="relative reveal">
      {/* Offset shadow frame */}
      <div
        aria-hidden="true"
        class="absolute -inset-3 border border-[var(--color-line-1)] translate-x-4 translate-y-4"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-[var(--color-lime)] opacity-[0.04] blur-3xl"
      ></div>

      <article class="relative border border-[var(--color-line-2)] bg-[var(--color-bg-1)] scanlines">
        {/* Window chrome */}
        <header
          class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b border-[var(--color-line-2)] px-4 sm:px-5 md:px-7 py-3.5 bg-[var(--color-bg-2)]"
        >
          <div class="flex min-w-0 items-center gap-3">
            <div class="flex shrink-0 items-center gap-2">
              <span class="block w-2.5 h-2.5 rounded-full bg-[var(--color-fg-4)]"></span>
              <span class="block w-2.5 h-2.5 rounded-full bg-[var(--color-fg-4)]"></span>
              <span class="block w-2.5 h-2.5 rounded-full bg-[var(--color-lime)]"></span>
            </div>
            <span class="hidden sm:inline shrink-0 text-[var(--color-line-2)]">|</span>
            <span
              class="min-w-0 truncate font-mono text-[10px] sm:text-[11px] tracking-[0.18em] uppercase text-[var(--color-fg-2)]"
            >
              rivaleye / perception report · notion.so
            </span>
          </div>
          <div class="flex shrink-0 items-center gap-2 font-mono text-[10px] tracking-widest uppercase">
            <span
              class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime"
            ></span>
            <span class="text-[var(--color-lime)]">Live · 04:12</span>
          </div>
        </header>

        {/* Stat strip */}
        <div
          class="grid grid-cols-2 md:grid-cols-4 border-b border-[var(--color-line-2)] bg-[var(--color-bg-1)]"
        >
          {
            sideStats.map((s, i) => (
              <div
                class={`px-4 sm:px-5 md:px-7 py-4 md:py-5 ${i < sideStats.length - 1 ? 'md:border-r border-[var(--color-line-1)]' : ''} ${i < 2 ? 'border-b md:border-b-0 border-[var(--color-line-1)]' : ''} ${i === 0 || i === 2 ? 'border-r border-[var(--color-line-1)] md:border-r' : ''}`}
              >
                <div class="label-mono mb-2 break-words">{s.label}</div>
                <div class="font-display text-xl sm:text-2xl md:text-3xl font-medium text-[var(--color-fg-0)] tracking-tight">
                  {s.value}
                </div>
              </div>
            ))
          }
        </div>

        {/* Body */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          {/* === LEFT: featured cluster + evidence === */}
          <div class="lg:col-span-7 border-b lg:border-b-0 lg:border-r border-[var(--color-line-2)] p-4 sm:p-5 md:p-7">
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 mb-5">
              <span
                class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-fg-3)]"
              >
                ▼ Featured cluster · #01 of 83
              </span>
              <span
                class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[10px] tracking-widest uppercase text-[var(--color-rose)]"
              >
                <span class="inline-block w-1.5 h-1.5 bg-[var(--color-rose)] animate-blink"></span>
                Critical
              </span>
            </div>

            {/* Cluster headline */}
            <h3 class="display-tight text-2xl sm:text-[28px] md:text-[36px] text-[var(--color-fg-0)] mb-5 leading-[1.05] break-words">
              Slow on large pages
            </h3>

            {/* Severity bar */}
            <div class="mb-6">
              <div class="flex items-baseline justify-between mb-2">
                <span class="label-mono">severity score</span>
                <span class="font-display text-2xl font-medium text-[var(--color-lime)] tracking-tight">
                  92
                  <span class="text-[var(--color-fg-3)] text-sm font-mono">/100</span>
                </span>
              </div>
              <div class="relative h-2 bg-[var(--color-bg-3)]">
                <div
                  class="absolute top-0 left-0 bottom-0 bg-[var(--color-lime)]"
                  style="width: 0%; animation: bar-fill-92 1.4s var(--ease-out-quart) 0.2s forwards;"
                ></div>
              </div>
            </div>

            {/* Mini stats inline */}
            <div class="grid grid-cols-3 gap-2 sm:gap-3 mb-7">
              <div class="border border-[var(--color-line-1)] bg-[var(--color-bg-0)] px-2.5 sm:px-3 py-2.5">
                <div class="label-mono mb-1">Mentions</div>
                <div class="font-display text-lg sm:text-xl font-medium text-[var(--color-fg-0)]">247</div>
              </div>
              <div class="border border-[var(--color-line-1)] bg-[var(--color-bg-0)] px-2.5 sm:px-3 py-2.5">
                <div class="label-mono mb-1">Sources</div>
                <div class="font-display text-lg sm:text-xl font-medium text-[var(--color-fg-0)]">7 / 7</div>
              </div>
              <div class="border border-[var(--color-line-1)] bg-[var(--color-bg-0)] px-2.5 sm:px-3 py-2.5">
                <div class="label-mono mb-1">Trend</div>
                <div class="font-display text-lg sm:text-xl font-medium text-[var(--color-lime)]">↑ 18%</div>
              </div>
            </div>

            {/* Evidence quotes */}
            <div>
              <div class="label-mono mb-3">▼ evidence · sample of 247</div>
              <ul class="space-y-2">
                {
                  evidence.map((e, i) => (
                    <li
                      class="border border-[var(--color-line-1)] bg-[var(--color-bg-0)] p-3.5 group hover:border-[var(--color-line-3)] transition-colors"
                      style={`opacity: 0; transform: translateY(8px); animation: quote-in 0.6s var(--ease-out-quart) ${0.5 + i * 0.12}s forwards;`}
                    >
                      <p class="text-[14px] leading-[1.45] text-[var(--color-fg-1)] mb-2 font-mono break-words">
                        “{e.quote}”
                      </p>
                      <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                        <span class="flex flex-wrap items-center gap-2">
                          <span class="text-[var(--color-lime)]">{e.src}</span>
                          <span>·</span>
                          <span>{e.upvotes} upvotes</span>
                        </span>
                        <span>{e.date}</span>
                      </div>
                    </li>
                  ))
                }
              </ul>
            </div>

            {/* Opportunity callout */}
            <div
              class="mt-6 border border-[var(--color-lime)] bg-[var(--color-lime)]/[0.06] p-4 md:p-5"
            >
              <div class="flex items-center gap-2 mb-2">
                <svg
                  class="w-3.5 h-3.5 text-[var(--color-lime)]"
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M2 7h10m0 0L9 4m3 3L9 10" stroke-linecap="square" />
                </svg>
                <span
                  class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-lime)]"
                >
                  Opportunity
                </span>
              </div>
              <p class="text-[15px] leading-[1.5] text-[var(--color-fg-0)]">
                A workspace that stays fast past 10,000 blocks. Performance is the wedge
                <span class="text-[var(--color-fg-2)]"
                  >247 users complaining, 18% growth week-over-week, no competitor solving it.</span
                >
              </p>
            </div>
          </div>

          {/* === RIGHT: cluster heatmap + lens index === */}
          <div class="lg:col-span-5 p-4 sm:p-5 md:p-7">
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 mb-5">
              <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-fg-3)]">
                ▼ all 83 clusters · severity grid
              </span>
              <span class="shrink-0 font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                hover ↗
              </span>
            </div>

            {/* Heatmap */}
            <div class="grid grid-cols-10 gap-1 mb-6">
              {
                heatmap.map((s, i) => (
                  <div
                    class="aspect-square bg-[var(--color-lime)] group cursor-pointer relative"
                    style={`opacity: 0; animation: cell-in 0.4s var(--ease-out-quart) ${0.6 + i * 0.012}s forwards; --target-opacity: ${opacityFor(s)};`}
                    data-target-opacity={opacityFor(s)}
                  >
                    <span class="absolute -top-7 left-1/2 -translate-x-1/2 hidden group-hover:flex font-mono text-[9px] tracking-widest uppercase text-[var(--color-fg-0)] bg-[var(--color-bg-3)] px-1.5 py-0.5 whitespace-nowrap pointer-events-none z-10">
                      #{i + 1} · {s}
                    </span>
                  </div>
                ))
              }
            </div>

            {/* Legend */}
            <div
              class="flex items-center justify-between mb-7 font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]"
            >
              <span>low</span>
              <div class="flex gap-1 flex-1 mx-3">
                {[0.15, 0.3, 0.5, 0.75, 1].map((o) => (
                  <div
                    class="flex-1 h-1.5 bg-[var(--color-lime)]"
                    style={`opacity: ${o}`}
                  ></div>
                ))}
              </div>
              <span class="text-[var(--color-lime)]">critical</span>
            </div>

            {/* Lens index */}
            <div>
              <span class="label-mono">▼ signal index</span>
              <ul class="mt-3 space-y-1.5">
                {
                  [
                    { lens: '01 / Love signals', n: 18 },
                    { lens: '02 / Pain signals', n: 24 },
                    { lens: '03 / Gap signals', n: 18 },
                    { lens: '04 / Switch signals', n: 9 },
                    { lens: '05 / Pricing signals', n: 11 },
                    { lens: '06 / Positioning signals', n: 7 },
                  ].map((row) => (
                    <li class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 py-1.5 border-b border-[var(--color-line-1)] last:border-b-0">
                      <span class="font-mono text-[12px] text-[var(--color-fg-1)] break-words">
                        {row.lens}
                      </span>
                      <span class="shrink-0 font-mono text-[10px] tracking-widest text-[var(--color-fg-3)]">
                        {row.n} clusters →
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        {/* Footer */}
        <footer
          class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 border-t border-[var(--color-line-2)] px-5 md:px-7 py-3.5 bg-[var(--color-bg-2)]"
        >
          <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
            scan_signature · 8c7a · 2417 complaints · 7 sources
          </span>
          <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-lime)]">
            next refresh
          </span>
        </footer>
      </article>
    </div>
  </div>
</section>

<style>
  @keyframes bar-fill-92 {
    to {
      width: 92%;
    }
  }
  @keyframes quote-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes cell-in {
    to {
      opacity: var(--target-opacity, 1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [style*='animation'] {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      width: 92% !important;
    }
  }
</style>
