---
// src/components/Hero.astro
const scanFeed = [
  { platform: 'reddit.com / r/Notion', count: 4827, found: 312, status: 'done' },
  { platform: 'g2.com / notion', count: 1247, found: 89, status: 'done' },
  { platform: 'capterra.com / notion', count: 642, found: 54, status: 'done' },
  { platform: 'producthunt.com / notion', count: 411, found: 31, status: 'done' },
  { platform: 'x.com / @NotionHQ mentions', count: 8910, found: 198, status: 'scanning' },
  { platform: 'apps.apple.com / notion', count: 12_204, found: 0, status: 'queued' },
];

const clusters = [
  { label: 'Slow on large pages', count: 247, severity: 92 },
  { label: 'Missing real offline mode', count: 194, severity: 88 },
  { label: 'Permissions are confusing', count: 156, severity: 71 },
  { label: 'AI features feel bolted-on', count: 132, severity: 64 },
];
---

<section
  id="main"
  class="relative isolate overflow-hidden bg-[var(--color-bg-0)] pt-10 md:pt-14 lg:pt-20 pb-24 lg:pb-32"
>
  {/* === Atmospheric backdrop ============================================ */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    {/* Grid */}
    <div class="absolute inset-0 bg-grid mask-fade-edges opacity-70"></div>

    {/* Lime corner glow — top-right */}
    <div
      class="absolute -top-32 -right-32 w-[640px] h-[640px] rounded-full opacity-[0.07] blur-[120px]"
      style="background: radial-gradient(circle, var(--color-lime) 0%, transparent 70%);"
    >
    </div>

    {/* Bottom fade into page */}
    <div
      class="absolute bottom-0 left-0 right-0 h-48"
      style="background: linear-gradient(to bottom, transparent, var(--color-bg-0));"
    >
    </div>

    {/* Horizontal hairline — runs across the whole hero at headline baseline */}
    <div
      class="absolute left-0 right-0 top-[58%] h-px bg-[var(--color-line-1)] hidden lg:block"
    >
    </div>

    {/* Tick marks on hairline */}
    <div class="absolute top-[58%] left-0 right-0 hidden lg:flex justify-between px-12">
      {
        Array.from({ length: 24 }).map((_, i) => (
          <span
            class="block w-px h-2 bg-[var(--color-line-2)] -translate-y-1"
            style={`opacity: ${i % 6 === 0 ? '0.6' : '0.2'}`}
          />
        ))
      }
    </div>
  </div>

  <div class="mx-auto max-w-[var(--container-page)] px-5 md:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      {/* ============================================================== */}
      {/* LEFT — copy column                                              */}
      {/* ============================================================== */}
      <div class="lg:col-span-7 reveal-stagger">
        {/* Eyebrow */}
        <div class="inline-flex items-center gap-3 mb-8 md:mb-10">
          <span class="inline-flex items-center gap-2 border border-[var(--color-line-2)] bg-[var(--color-bg-1)]/60 backdrop-blur-sm px-3 py-1.5">
            <span
              class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime"
            ></span>
            <span
              class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-2)]"
              >Competitor intelligence · Q1 2026</span
            >
          </span>
        </div>

        {/* Headline */}
        <h1
          class="display-tight text-[var(--color-fg-0)] text-[clamp(3rem,7.5vw,7.5rem)]"
        >
          <span class="block">Find what your</span>
          <span class="block">competitor's users</span>
          <span class="block relative">
            <span class="relative inline-block text-[var(--color-lime)] glow-lime-text">
              hate
              <span
                aria-hidden="true"
                class="absolute -right-3 top-[18%] bottom-[18%] w-[3px] bg-[var(--color-lime)] animate-blink"
              ></span>
            </span>
            <span class="text-[var(--color-fg-0)]"> — </span>
            <span class="text-[var(--color-fg-0)]">before</span>
          </span>
          <span class="block">you build.</span>
        </h1>

        {/* Sub-copy */}
        <p
          class="mt-8 md:mt-10 max-w-[560px] text-[17px] md:text-[18px] leading-[1.55] text-[var(--color-fg-2)]"
        >
          RivalEye scrapes every complaint about any competitor across
          <span class="text-[var(--color-fg-1)]"
            >Reddit, G2, Capterra, Product Hunt, X, the App Store, Play Store, and Google Maps</span
          >. AI clusters them into a Pain Report so you ship what users actually want — not what
          you assume.
        </p>

        {/* CTAs */}
        <div class="mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href="#cta"
            class="group relative inline-flex items-center justify-center gap-2 bg-[var(--color-lime)] text-[var(--color-bg-0)] px-6 py-4 font-mono text-[12px] font-medium tracking-[0.18em] uppercase hover:bg-[var(--color-lime-1)] transition-colors glow-lime-md"
          >
            <span class="relative z-10">Run a free scan</span>
            <svg
              class="relative z-10 w-3.5 h-3.5 transition-transform group-hover:translate-x-1"
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <path d="M2 7h10m0 0L9 4m3 3L9 10" stroke-linecap="square" />
            </svg>
          </a>
          <a
            href="#report"
            class="group inline-flex items-center justify-center gap-2 border border-[var(--color-line-2)] bg-[var(--color-bg-1)]/40 backdrop-blur-sm text-[var(--color-fg-1)] px-6 py-4 font-mono text-[12px] font-medium tracking-[0.18em] uppercase hover:border-[var(--color-line-3)] hover:bg-[var(--color-bg-2)] transition-colors"
          >
            See a sample report
            <span class="text-[var(--color-fg-3)] group-hover:text-[var(--color-lime)] transition-colors">↗</span>
          </a>
        </div>

        {/* Trust stats */}
        <dl class="mt-12 md:mt-16 grid grid-cols-3 gap-6 max-w-[560px] pt-8 border-t border-[var(--color-line-1)]">
          <div>
            <dt class="label-mono mb-2">Sources scanned</dt>
            <dd class="font-display text-3xl md:text-4xl font-medium text-[var(--color-fg-0)] tracking-tight">
              <span data-counter="8" data-counter-decimals="0">0</span>
            </dd>
          </div>
          <div>
            <dt class="label-mono mb-2">Avg. complaints / scan</dt>
            <dd class="font-display text-3xl md:text-4xl font-medium text-[var(--color-fg-0)] tracking-tight">
              <span data-counter="2417" data-counter-decimals="0">0</span>
            </dd>
          </div>
          <div>
            <dt class="label-mono mb-2">Time to first report</dt>
            <dd class="font-display text-3xl md:text-4xl font-medium text-[var(--color-fg-0)] tracking-tight">
              <span data-counter="4">0</span><span class="text-[var(--color-fg-3)]">m</span>
            </dd>
          </div>
        </dl>
      </div>

      {/* ============================================================== */}
      {/* RIGHT — terminal scan visual                                    */}
      {/* ============================================================== */}
      <div class="lg:col-span-5 relative">
        <div class="relative">
          {/* Decorative offset frame behind the panel */}
          <div
            aria-hidden="true"
            class="absolute -inset-2 border border-[var(--color-line-1)] translate-x-3 translate-y-3"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute inset-0 bg-[var(--color-lime)] opacity-[0.04] blur-3xl"
          ></div>

          {/* Main terminal panel */}
          <div
            class="relative border border-[var(--color-line-2)] bg-[var(--color-bg-1)] scanlines overflow-hidden"
          >
            {/* Window chrome */}
            <div
              class="flex items-center justify-between border-b border-[var(--color-line-1)] px-4 py-3 bg-[var(--color-bg-2)]"
            >
              <div class="flex items-center gap-2">
                <span class="block w-2.5 h-2.5 rounded-full bg-[var(--color-fg-4)]"></span>
                <span class="block w-2.5 h-2.5 rounded-full bg-[var(--color-fg-4)]"></span>
                <span class="block w-2.5 h-2.5 rounded-full bg-[var(--color-lime)]"></span>
              </div>
              <div
                class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]"
              >
                scan / notion.report
              </div>
              <div class="flex items-center gap-1.5 font-mono text-[10px] tracking-widest uppercase">
                <span
                  class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime"
                ></span>
                <span class="text-[var(--color-lime)]">LIVE</span>
              </div>
            </div>

            {/* Scanning log */}
            <div class="relative px-5 py-5 font-mono text-[12px] leading-[1.7] text-[var(--color-fg-2)]">
              {/* Animated scan line */}
              <div
                aria-hidden="true"
                class="absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--color-lime)] to-transparent animate-scan opacity-60"
                style="top: 0;"
              >
              </div>

              <div class="space-y-1.5">
                {
                  scanFeed.map((row, i) => (
                    <div
                      class="grid grid-cols-[auto_1fr_auto] gap-3 items-center"
                      data-scan-row
                      style={`opacity: 0; animation: scan-row-in 0.6s var(--ease-out-quart) ${0.2 + i * 0.18}s forwards;`}
                    >
                      <span class="text-[var(--color-fg-4)]">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <span class="truncate">
                        <span class="text-[var(--color-fg-3)]">{'> '}</span>
                        <span class="text-[var(--color-fg-1)]">{row.platform}</span>
                        <span class="text-[var(--color-fg-4)]"> · {row.count.toLocaleString()} parsed</span>
                      </span>
                      <span class="font-mono text-[10px] tracking-widest uppercase">
                        {row.status === 'done' && (
                          <span class="text-[var(--color-lime)]">+{row.found}</span>
                        )}
                        {row.status === 'scanning' && (
                          <span class="text-[var(--color-amber)] inline-flex items-center gap-1.5">
                            <span class="inline-block w-1 h-1 bg-[var(--color-amber)] animate-blink" />
                            scanning
                          </span>
                        )}
                        {row.status === 'queued' && (
                          <span class="text-[var(--color-fg-4)]">queued</span>
                        )}
                      </span>
                    </div>
                  ))
                }
              </div>

              {/* Cursor line */}
              <div class="mt-2 flex items-center gap-2 text-[var(--color-fg-3)]">
                <span class="text-[var(--color-lime)]">{'>'}</span>
                <span>clustering 684 complaints</span>
                <span class="inline-block w-2 h-3 bg-[var(--color-lime)] animate-blink"></span>
              </div>
            </div>

            {/* Divider with caption */}
            <div class="border-t border-[var(--color-line-1)] px-5 py-2 bg-[var(--color-bg-0)]/40">
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
                ▼ clusters detected · sorted by severity
              </span>
            </div>

            {/* Cluster bars */}
            <div class="px-5 py-5 space-y-3">
              {
                clusters.map((c, i) => (
                  <div
                    style={`opacity: 0; animation: scan-row-in 0.7s var(--ease-out-quart) ${1.3 + i * 0.14}s forwards;`}
                  >
                    <div class="flex items-baseline justify-between mb-1.5">
                      <span class="text-[12px] text-[var(--color-fg-1)] truncate pr-3">
                        {c.label}
                      </span>
                      <span class="font-mono text-[10px] tracking-widest text-[var(--color-fg-3)] whitespace-nowrap">
                        {c.count} <span class="text-[var(--color-fg-4)]">mentions</span>
                      </span>
                    </div>
                    <div class="relative h-1 bg-[var(--color-bg-3)] overflow-hidden">
                      <div
                        class="absolute left-0 top-0 bottom-0 bg-[var(--color-lime)]"
                        style={`width: 0%; animation: bar-fill 1s var(--ease-out-quart) ${1.5 + i * 0.14}s forwards; --bar-target: ${c.severity}%;`}
                        data-bar-target={c.severity}
                      />
                    </div>
                  </div>
                ))
              }
            </div>

            {/* Footer status */}
            <div
              class="border-t border-[var(--color-line-1)] px-5 py-3 bg-[var(--color-bg-2)]/40 flex items-center justify-between"
            >
              <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                report.ready in 00:04:12
              </span>
              <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-lime)]">
                684 / 8 sources
              </span>
            </div>
          </div>
        </div>

        {/* Small caption under panel */}
        <p
          class="mt-6 font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)] text-center lg:text-left"
        >
          ↑ Live scan of a real competitor — no setup
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scan-row-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes bar-fill {
    to {
      width: var(--bar-target, 50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-scan-row] {
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>

<script>
  // Apply the per-bar width via custom property so the @keyframes bar-fill picks it up.
  document.querySelectorAll<HTMLElement>('[data-bar-target]').forEach((el) => {
    const v = el.dataset.barTarget;
    if (v) el.style.setProperty('--bar-target', `${v}%`);
  });
</script>
