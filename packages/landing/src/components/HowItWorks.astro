---
// src/components/HowItWorks.astro
// Section 02 — three steps, alternating layout, vertical rail.

const steps = [
  {
    n: '01',
    title: 'Drop in a competitor.',
    desc: 'A name, a domain, an App Store URL — anything. RivalEye finds them across every relevant platform.',
    bullets: ['no integrations', 'no API keys', 'no setup'],
    visual: 'input',
  },
  {
    n: '02',
    title: 'Scan public conversations.',
    desc: 'RivalEye analyzes Reddit, Hacker News, Dev.to, Product Hunt, app reviews, and competitor websites — concurrently. Most scans complete in under five minutes.',
    bullets: ['7 sources', 'daily refresh', 'historical data'],
    visual: 'scan',
  },
  {
    n: '03',
    title: 'Get your perception report.',
    desc: 'User signals get organized into love, pain, gap, and switch signals — plus pricing and positioning insights. Six lenses to understand different decisions. Every insight is sourced.',
    bullets: ['6 signal lenses', 'severity ranked', 'fully sourced evidence'],
    visual: 'report',
  },
];
---

<section
  id="how"
  aria-labelledby="how-heading"
  class="relative bg-[var(--color-bg-0)] py-24 md:py-32 overflow-hidden border-t border-[var(--color-line-1)]"
>
  {/* Subtle backdrop */}
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid opacity-30 mask-fade-edges"></div>
    <div
      class="absolute top-1/2 -right-40 w-[500px] h-[500px] rounded-full opacity-[0.04] blur-[120px]"
      style="background: radial-gradient(circle, var(--color-lime) 0%, transparent 70%);"
    >
    </div>
  </div>

  <div class="mx-auto max-w-[var(--container-page)] px-5 md:px-8">
    {/* Section header */}
    <div class="mb-16 md:mb-24 reveal-stagger">
      <div class="flex items-center gap-3 mb-6">
        <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-lime)]">§ 02</span>
        <span class="block w-8 h-px bg-[var(--color-line-2)]"></span>
        <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-fg-2)]">
          How it works
        </span>
      </div>
      <h2
        id="how-heading"
        class="display-tight text-[var(--color-fg-0)] text-[clamp(2.5rem,5.5vw,5rem)] max-w-[18ch]"
      >
        Three steps. <span class="text-[var(--color-lime)]">No</span>
        <span class="text-[var(--color-lime)]"> integrations</span>.
      </h2>
    </div>

    {/* Steps */}
    <div class="relative">
      {/* Vertical rail (desktop only) */}
      <div
        aria-hidden="true"
        class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2"
      >
        <div class="h-full w-full bg-gradient-to-b from-transparent via-[var(--color-line-2)] to-transparent"></div>
      </div>

      <div class="space-y-24 md:space-y-32">
        {
          steps.map((step, idx) => (
            <div
              class={`relative grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center reveal-stagger ${
                idx % 2 === 1 ? 'lg:[direction:rtl]' : ''
              }`}
            >
              {/* Rail dot */}
              <span
                aria-hidden="true"
                class="hidden lg:block absolute left-1/2 top-12 -translate-x-1/2 w-3 h-3 border border-[var(--color-lime)] bg-[var(--color-bg-0)]"
              >
                <span class="absolute inset-1 bg-[var(--color-lime)]" />
              </span>

              {/* Text column */}
              <div class="lg:col-span-5 [direction:ltr]">
                <div class="flex items-baseline gap-4 mb-6">
                  <span class="font-display text-7xl md:text-8xl font-medium text-[var(--color-lime)] tracking-tight leading-none">
                    {step.n}
                  </span>
                  <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-lime)] pb-2">
                    / step {step.n}
                  </span>
                </div>
                <h3 class="display-tight text-[var(--color-fg-0)] text-[clamp(1.75rem,3.2vw,2.75rem)] max-w-[16ch] mb-5">
                  {step.title}
                </h3>
                <p class="text-[16px] md:text-[17px] leading-[1.6] text-[var(--color-fg-2)] max-w-[44ch] mb-6">
                  {step.desc}
                </p>
                <ul class="flex flex-wrap gap-2">
                  {step.bullets.map((b) => (
                    <li class="inline-flex items-center gap-2 border border-[var(--color-line-2)] bg-[var(--color-bg-1)] px-3 py-1.5">
                      <span class="inline-block w-1 h-1 rounded-full bg-[var(--color-lime)]" />
                      <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-2)]">
                        {b}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Visual column */}
              <div class="lg:col-span-6 lg:col-start-7 [direction:ltr]">
                {step.visual === 'input' && (
                  <div class="relative border border-[var(--color-line-2)] bg-[var(--color-bg-1)] scanlines">
                    <div class="flex items-center justify-between border-b border-[var(--color-line-1)] px-4 py-2.5 bg-[var(--color-bg-2)]">
                      <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
                        rivaleye / new-scan
                      </span>
                      <span class="flex items-center gap-1.5 font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                        ⌘ K
                      </span>
                    </div>
                    <div class="p-6">
                      <label class="block label-mono mb-3">target competitor</label>
                      <div class="flex items-center gap-3 border border-[var(--color-line-3)] bg-[var(--color-bg-0)] px-4 py-4">
                        <span class="text-[var(--color-lime)] font-mono">{'>'}</span>
                        <span class="flex-1 font-mono text-[15px] text-[var(--color-fg-0)]">
                          notion.so
                        </span>
                        <span class="inline-block w-2 h-4 bg-[var(--color-lime)] animate-blink" />
                      </div>
                      <div class="mt-5 space-y-1.5">
                        <div class="flex items-center justify-between font-mono text-[11px] text-[var(--color-fg-3)]">
                          <span>↳ Identified</span>
                          <span class="text-[var(--color-lime)]">Notion · SaaS · Workspace</span>
                        </div>
                        <div class="flex items-center justify-between font-mono text-[11px] text-[var(--color-fg-3)]">
                          <span>↳ Domains found</span>
                          <span class="text-[var(--color-fg-1)]">11 across 8 platforms</span>
                        </div>
                        <div class="flex items-center justify-between font-mono text-[11px] text-[var(--color-fg-3)]">
                          <span>↳ Ready to scan</span>
                          <span class="inline-flex items-center gap-1.5 text-[var(--color-lime)]">
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-lime)] animate-pulse-lime" />
                            yes
                          </span>
                        </div>
                      </div>
                      <button
                        type="button"
                        class="mt-6 w-full bg-[var(--color-lime)] text-[var(--color-bg-0)] py-3 font-mono text-[11px] font-medium tracking-[0.22em] uppercase hover:bg-[var(--color-lime-1)] transition-colors"
                      >
                        Begin scan →
                      </button>
                    </div>
                  </div>
                )}

                {step.visual === 'scan' && (
                  <div class="relative border border-[var(--color-line-2)] bg-[var(--color-bg-1)] scanlines">
                    <div class="flex items-center justify-between border-b border-[var(--color-line-1)] px-4 py-2.5 bg-[var(--color-bg-2)]">
                      <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
                        rivaleye / scan in progress
                      </span>
                      <span class="flex items-center gap-1.5 font-mono text-[10px] tracking-widest uppercase">
                        <span class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime" />
                        <span class="text-[var(--color-lime)]">live</span>
                      </span>
                    </div>
                    <div class="p-6 grid grid-cols-2 gap-3">
                      {[
                        { src: 'reddit', pct: 100, found: 312 },
                        { src: 'hackernews', pct: 100, found: 48 },
                        { src: 'dev.to', pct: 100, found: 21 },
                        { src: 'producthunt', pct: 100, found: 31 },
                        { src: 'apple', pct: 100, found: 247 },
                        { src: 'play', pct: 100, found: 94 },
                        { src: 'website', pct: 67, found: 67 },
                      ].map((p) => (
                        <div class="border border-[var(--color-line-1)] bg-[var(--color-bg-0)] p-3">
                          <div class="flex items-center justify-between mb-2">
                            <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-2)]">
                              {p.src}
                            </span>
                            <span class="font-mono text-[10px] tracking-widest text-[var(--color-fg-3)]">
                              {p.pct}%
                            </span>
                          </div>
                          <div class="relative h-1 bg-[var(--color-bg-3)] overflow-hidden">
                            <div
                              class="absolute left-0 top-0 bottom-0 bg-[var(--color-lime)]"
                              style={`width: ${p.pct}%`}
                            />
                          </div>
                          <div class="mt-2 font-mono text-[10px] tracking-widest text-[var(--color-fg-3)]">
                            {p.found > 0 ? `+${p.found} complaints` : 'queued'}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {step.visual === 'report' && (
                  <div class="relative border border-[var(--color-line-2)] bg-[var(--color-bg-1)] scanlines">
                    <div class="flex items-center justify-between border-b border-[var(--color-line-1)] px-4 py-2.5 bg-[var(--color-bg-2)]">
                      <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
                        notion.report.pain
                      </span>
                      <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-lime)]">
                        ready · 04:12
                      </span>
                    </div>
                    <div class="p-6">
                      <div class="flex items-baseline justify-between mb-4">
                        <span class="font-display text-2xl font-medium text-[var(--color-fg-0)] tracking-tight">
                          Perception Report
                        </span>
                        <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                          v.01
                        </span>
                      </div>
                      <div class="space-y-3">
                        {[
                          { lens: 'Love signals', n: 18 },
                          { lens: 'Pain signals', n: 24 },
                          { lens: 'Gap signals', n: 18 },
                          { lens: 'Switch signals', n: 9 },
                          { lens: 'Pricing signals', n: 11 },
                          { lens: 'Positioning signals', n: 7 },
                        ].map((lens) => (
                          <div class="flex items-center justify-between py-2 border-b border-[var(--color-line-1)] last:border-b-0">
                            <div class="flex items-center gap-3">
                              <span class="block w-1 h-4 bg-[var(--color-lime)]" />
                              <span class="text-[14px] text-[var(--color-fg-1)]">{lens.lens}</span>
                            </div>
                            <span class="font-mono text-[10px] tracking-widest text-[var(--color-fg-3)]">
                              {lens.n} clusters
                            </span>
                          </div>
                        ))}
                      </div>
                      <div class="mt-5 pt-4 border-t border-[var(--color-line-2)] flex items-center justify-between">
                        <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                          Total clusters
                        </span>
                        <span class="font-display text-3xl font-medium text-[var(--color-lime)] tracking-tight">
                          83
                        </span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
