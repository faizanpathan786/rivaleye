---
// src/components/PlatformRow.astro
// 8 sources RivalEye scans. Rendered as a continuous marquee for impact.
// Abstract glyph marks (not brand logos) to keep the terminal aesthetic consistent.

const platforms = [
  { name: 'Reddit', sub: 'r/* threads', glyph: 'reddit' },
  { name: 'Hacker News', sub: 'discussions', glyph: 'hackernews' },
  { name: 'Dev.to', sub: 'articles', glyph: 'devto' },
  { name: 'Product Hunt', sub: 'launch threads', glyph: 'producthunt' },
  { name: 'App Store', sub: 'reviews', glyph: 'apple' },
  { name: 'Play Store', sub: 'reviews', glyph: 'play' },
  { name: 'Websites', sub: 'public discussion', glyph: 'website' },
];

// Duplicate the list for seamless marquee
const marqueeList = [...platforms, ...platforms];
---

<section
  aria-labelledby="platforms-label"
  class="relative border-y border-[var(--color-line-1)] bg-[var(--color-bg-1)] py-10 md:py-14 overflow-hidden"
>
  <div class="mx-auto max-w-[var(--container-page)] px-5 md:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8 md:mb-10">
      <div class="flex items-center gap-3">
        <span class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime"></span>
        <h2
          id="platforms-label"
          class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-fg-2)]"
        >
          Sources monitored · 7 platforms · 24/7
        </h2>
      </div>
      <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-[var(--color-fg-3)]">
        ↗ Continuously updated
      </p>
    </div>
  </div>

  {/* Marquee — full-bleed, two rows scrolling opposite directions for depth */}
  <div class="relative">
    {/* Fade masks */}
    <div
      aria-hidden="true"
      class="absolute left-0 top-0 bottom-0 w-12 sm:w-20 md:w-32 z-10 pointer-events-none"
      style="background: linear-gradient(to right, var(--color-bg-1), transparent);"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute right-0 top-0 bottom-0 w-12 sm:w-20 md:w-32 z-10 pointer-events-none"
      style="background: linear-gradient(to left, var(--color-bg-1), transparent);"
    >
    </div>

    <div class="flex animate-marquee">
      {
        marqueeList.map((p) => (
          <article class="flex-shrink-0 mx-2 sm:mx-3 flex items-center gap-3 sm:gap-4 border border-[var(--color-line-1)] bg-[var(--color-bg-0)]/60 px-4 py-3 sm:px-6 sm:py-4 min-w-[220px] sm:min-w-[280px] group hover:border-[var(--color-line-3)] transition-colors">
            <div class="flex-shrink-0 w-9 h-9 border border-[var(--color-line-2)] bg-[var(--color-bg-2)] flex items-center justify-center text-[var(--color-lime)] group-hover:bg-[var(--color-bg-3)] transition-colors">
              {/* Abstract glyph per platform — geometric, not branded */}
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5">
                {p.glyph === 'reddit' && (
                  <>
                    <circle cx="12" cy="13" r="7" />
                    <circle cx="9.5" cy="13" r="1" fill="currentColor" />
                    <circle cx="14.5" cy="13" r="1" fill="currentColor" />
                    <path d="M9 16c1 1 4.5 1 6 0" stroke-linecap="round" />
                    <circle cx="17.5" cy="6" r="1.5" />
                    <line x1="13" y1="9" x2="16.5" y2="7" />
                  </>
                )}
                {p.glyph === 'producthunt' && (
                  <>
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9 7v10M9 7h4a3 3 0 010 6H9" stroke-linecap="square" />
                  </>
                )}
                {p.glyph === 'hackernews' && (
                  <>
                    <path d="M3 3h18v18H3z" stroke-linejoin="round" />
                    <text x="12" y="16" text-anchor="middle" font-size="10" font-family="monospace" fill="currentColor" stroke="none">
                      Y
                    </text>
                  </>
                )}
                {p.glyph === 'devto' && (
                  <>
                    <path d="M5 9l7-6 7 6v9H5z" stroke-linejoin="round" />
                  </>
                )}
                {p.glyph === 'apple' && (
                  <>
                    <path d="M12 6c0-1.5 1-3 2.5-3.5M8 11c0-3 2-5 4-5s4 2 4 5c0 2.5-1 5-2 6.5-1 1.5-2 2.5-2 2.5s-1-1-2-2.5C9 16 8 13.5 8 11z" stroke-linejoin="round" />
                  </>
                )}
                {p.glyph === 'play' && (
                  <>
                    <path d="M5 3l13 9-13 9z" stroke-linejoin="round" />
                  </>
                )}
                {p.glyph === 'website' && (
                  <>
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 3v18M3 12h18M4.22 4.22a9 9 0 0115.56 0M4.22 19.78a9 9 0 0115.56 0" stroke-linecap="round" />
                  </>
                )}
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="font-display text-base font-medium text-[var(--color-fg-0)] tracking-tight">
                {p.name}
              </span>
              <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
                {p.sub}
              </span>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
              <span class="inline-block w-1 h-1 rounded-full bg-[var(--color-lime)] animate-blink"></span>
              <span class="font-mono text-[10px] tracking-widest uppercase text-[var(--color-lime)]">
                live
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
