---
// src/components/FAQ.astro
// Section 05 — terminal-style expandable FAQ.

const faqs = [
  {
    q: 'Is RivalEye just social listening?',
    a: 'No. Social listening usually tracks mentions and sentiment. RivalEye extracts decision-ready signals: what users love, what frustrates them, what they want next, and who may be ready to switch.',
  },
  {
    q: 'Is this only for finding competitor complaints?',
    a: 'No. RivalEye is balanced. It shows what users love and why they stay, along with pain, gaps, pricing signals, and switch intent.',
  },
  {
    q: 'Who is RivalEye built for?',
    a: 'RivalEye is built for B2B SaaS founders, product teams, marketers, and growth teams that compete in active categories.',
  },
  {
    q: 'What sources does RivalEye analyze?',
    a: 'RivalEye starts with public sources like Reddit, Product Hunt, Hacker News, app reviews, Dev.to, and competitor websites. Source coverage will expand over time.',
  },
  {
    q: 'How is this different from manually reading Reddit or reviews?',
    a: 'Manual research is slow and easy to miss. RivalEye clusters signals, shows evidence, and turns them into role-specific dashboards your team can act on.',
  },
  {
    q: 'How long does a scan take?',
    a: 'Most scans complete in three to seven minutes. The first scan of a new competitor takes longest because we build out the historical archive. Subsequent refreshes are incremental and finish in under sixty seconds.',
  },
  {
    q: 'Does RivalEye generate leads?',
    a: 'RivalEye can surface public switch-intent conversations, but it is not an auto-spam tool. It helps you understand context and engage thoughtfully.',
  },
  {
    q: 'Do insights include evidence?',
    a: 'Yes. Every major insight points back to source quotes, links, signal types, and confidence scores. You can verify claims in two clicks.',
  },
];
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="relative bg-[var(--color-bg-0)] py-24 md:py-32 border-t border-[var(--color-line-1)] overflow-hidden"
>
  {/* Backdrop */}
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid-fine opacity-20 mask-fade-edges"></div>
  </div>

  <div class="mx-auto max-w-[var(--container-page)] px-5 md:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      {/* Left — sticky meta */}
      <div class="lg:col-span-4 lg:sticky lg:top-32 reveal-stagger">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-lime)]"
            >05</span
          >
          <span class="block w-8 h-px bg-[var(--color-line-2)]"></span>
          <span class="font-mono text-[11px] tracking-[0.22em] uppercase text-[var(--color-fg-2)]">
            Questions
          </span>
        </div>
        <h2
          id="faq-heading"
          class="display-tight text-[var(--color-fg-0)] text-[clamp(2.25rem,4.5vw,4rem)] mb-6"
        >
          The honest answers.
        </h2>
        <p class="text-[15px] leading-[1.6] text-[var(--color-fg-2)] max-w-[36ch] mb-8">
          Everything we get asked before a first scan. If something isn't here, ask us replies go
          to a real human.
        </p>

        {/* Stat strip */}
        <div class="grid grid-cols-2 gap-px bg-[var(--color-line-1)] border border-[var(--color-line-1)] mb-8">
          <div class="bg-[var(--color-bg-0)] p-4">
            <div class="label-mono mb-1.5">Questions</div>
            <div class="font-display text-2xl font-medium text-[var(--color-fg-0)] tracking-tight">
              {faqs.length} / {faqs.length}
            </div>
          </div>
          <div class="bg-[var(--color-bg-0)] p-4">
            <div class="label-mono mb-1.5">Avg. reply</div>
            <div class="font-display text-2xl font-medium text-[var(--color-fg-0)] tracking-tight">
              &lt; 2h
            </div>
          </div>
        </div>

        <a
          href="mailto:hi@rivaleye.io"
          class="inline-flex w-full sm:w-auto items-center justify-center sm:justify-start gap-2 border border-[var(--color-line-2)] bg-[var(--color-bg-1)] px-4 py-3 font-mono text-[11px] font-medium tracking-[0.18em] uppercase text-[var(--color-fg-1)] hover:border-[var(--color-line-3)] hover:bg-[var(--color-bg-2)] transition-colors"
        >
          <span>Ask a new question</span>
          <span class="text-[var(--color-lime)]">↗</span>
        </a>
      </div>

      {/* Right — Q/A list */}
      <div class="lg:col-span-8 reveal-stagger">
        <div class="border-t border-[var(--color-line-2)]">
          {
            faqs.map((item, i) => (
              <details class="group border-b border-[var(--color-line-2)]" name="faq">
                <summary class="flex items-start gap-3 sm:gap-4 md:gap-6 py-5 md:py-7 cursor-pointer list-none hover:bg-[var(--color-bg-1)]/40 transition-colors">
                  <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-fg-4)] pt-1.5 whitespace-nowrap">
                    Q.{String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="font-display text-[17px] sm:text-[19px] md:text-[22px] font-medium text-[var(--color-fg-0)] tracking-tight leading-[1.3] flex-1 break-words">
                    {item.q}
                  </span>
                  <span
                    aria-hidden="true"
                    class="font-mono text-[var(--color-lime)] text-lg leading-none pt-1.5 transition-transform duration-300 group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <div class="pl-[3.25rem] sm:pl-[3.75rem] md:pl-[5rem] pr-1 sm:pr-6 md:pr-10 pb-7 -mt-2">
                  <div class="flex items-start gap-3 sm:gap-4 md:gap-6">
                    <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-lime)] pt-1 whitespace-nowrap -ml-[3.25rem] sm:-ml-[3.75rem] md:-ml-[5rem]">
                      A.{String(i + 1).padStart(2, '0')}
                    </span>
                    <p class="text-[15px] md:text-[16px] leading-[1.65] text-[var(--color-fg-2)] max-w-[64ch] break-words">
                      {item.a}
                    </p>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  details summary {
    user-select: none;
  }
</style>
