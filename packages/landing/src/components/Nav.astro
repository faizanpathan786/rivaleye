---
// src/components/Nav.astro
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:4004';
const navLinks = [
  { label: 'How it works', href: '#how' },
  { label: 'Report', href: '#report' },
  { label: 'Lenses', href: '#lenses' },
  { label: 'FAQ', href: '#faq' },
];
---

<header class="sticky top-0 z-40 w-full">
  {/* Top status bar — desktop only, terminal-chrome feel */}
  <div
    class="hidden md:flex items-center justify-between border-b border-[var(--color-line-0)] bg-[var(--color-bg-0)]/70 backdrop-blur-md px-6 py-1.5"
  >
    <div class="flex items-center gap-4 font-mono text-[10px] tracking-widest uppercase text-[var(--color-fg-3)]">
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-1.5 h-1.5 bg-[var(--color-lime)] rounded-full animate-pulse-lime"></span>
        Live · scanning 8 sources
      </span>
    </div>
  </div>

  {/* Main nav row */}
  <nav
    class="border-b border-[var(--color-line-1)] bg-[var(--color-bg-0)]/85 backdrop-blur-xl"
    aria-label="Primary"
  >
    <div class="mx-auto max-w-[var(--container-page)] px-5 md:px-8">
      <div class="flex h-16 items-center justify-between gap-3 sm:gap-6">
        {/* Wordmark */}
        <a href="/" class="group flex items-center gap-2.5" aria-label="RivalEye home">
          <img src="/logo.svg" alt="RivalEye logo" width="32" height="32" style="object-fit:contain;border-radius:6px;" />
          <span class="flex items-baseline gap-2">
            <span
              class="font-display text-[19px] font-medium tracking-tight text-[var(--color-fg-0)]"
              >Rival<span class="text-[var(--color-lime)]">Eye</span></span
            >
          </span>
        </a>

        {/* Center links */}
        <ul class="hidden lg:flex items-center gap-1">
          {
            navLinks.map((link, i) => (
              <li>
                <a
                  href={link.href}
                  class="group relative inline-flex items-center gap-2 px-3 py-2 font-mono text-[11px] tracking-widest uppercase text-[var(--color-fg-2)] hover:text-[var(--color-fg-0)] transition-colors duration-200"
                >
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>

        {/* Right side */}
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href={appUrl}
            class="group relative inline-flex items-center gap-1.5 sm:gap-2 bg-[var(--color-lime)] text-[var(--color-bg-0)] px-3 sm:px-4 py-2.5 min-h-[44px] font-mono text-[11px] font-medium tracking-widest uppercase hover:bg-[var(--color-lime-1)] transition-colors"
          >
            <span class="relative z-10">Run a scan</span>
            <svg
              class="relative z-10 w-3 h-3 transition-transform group-hover:translate-x-0.5"
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <path d="M2 6h8m0 0L7 3m3 3L7 9" stroke-linecap="square" />
            </svg>
            <span
              class="absolute inset-0 bg-[var(--color-lime)] blur-md opacity-0 group-hover:opacity-60 -z-10 transition-opacity duration-500"
            ></span>
          </a>

          {/* Mobile menu toggle */}
          <button
            type="button"
            class="lg:hidden inline-flex items-center justify-center w-11 h-11 border border-[var(--color-line-2)] text-[var(--color-fg-1)]"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            data-mobile-toggle
          >
            <svg viewBox="0 0 16 16" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="square" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    {/* Mobile menu panel */}
    <div
      id="mobile-nav-panel"
      class="lg:hidden hidden border-t border-[var(--color-line-1)] bg-[var(--color-bg-1)]"
      data-mobile-panel
    >
      <ul class="px-5 py-4 space-y-1">
        {
          navLinks.map((link, i) => (
            <li>
              <a
                href={link.href}
                class="flex items-center gap-3 min-h-[44px] py-3 font-mono text-[12px] tracking-widest uppercase text-[var(--color-fg-1)]"
              >
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  // Live UTC clock in the status bar
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const update = () => {
      const now = new Date();
      const hh = String(now.getUTCHours()).padStart(2, '0');
      const mm = String(now.getUTCMinutes()).padStart(2, '0');
      const ss = String(now.getUTCSeconds()).padStart(2, '0');
      clock.textContent = `${hh}:${mm}:${ss} UTC`;
    };
    update();
    setInterval(update, 1000);
  }

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  // Close the panel after tapping a link inside it
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      panel.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    })
  );
</script>
