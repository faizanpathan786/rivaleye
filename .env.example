CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/rivaleye

BETTER_AUTH_SECRET=change-me-in-prod
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scraper credentials (worker)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=rivaleye/0.1
REDDIT_MAX_TERMS=              # cap search terms (9 total: 5 complaint-biased, 4 neutral; use 2-3 for dev)
REDDIT_MAX_POSTS_PER_TERM=     # cap posts per term (default: 50, use 10-15 for dev)
PRODUCTHUNT_TOKEN=
TRUSTPILOT_API_KEY=
X_API_BEARER=
APIFY_TOKEN=
GOOGLE_PLACES_API_KEY=

# LLM (shared client used by api + worker)
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_MODEL=deepseek/deepseek-chat

# Razorpay (billing)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Frontend
VITE_API_URL=http://localhost:4000
VITE_LOGODEV_TOKEN=sk_your_token_here
VITE_RAZORPAY_KEY_ID=rzp_test_

# Job orchestration engine: postgres or inngest
# Default: postgres (recommended for MVP)
# Only set INNGEST_EVENT_KEY if using inngest engine
REPORT_PIPELINE_ENGINE=postgres

# Inngest — leave blank for local dev (uses the inngest-cli dev server)
# Only required when REPORT_PIPELINE_ENGINE=inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Worker ports (Inngest dev server discovers these)
WORKER_SCRAPE_PORT=4001
WORKER_LLM_PORT=4002
WORKER_SYNTH_PORT=4003
